{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Attach to Backend (Docker)",
      "port": 9229,
      "request": "attach",
      "skipFiles": ["<node_internals>/**"],
      "type": "node",
      "remoteRoot": "/app/backend",
      "localRoot": "${workspaceFolder}/backend",
      "restart": true,
      "sourceMaps": true
    },
    {
      "name": "Launch Frontend (Chrome)",
      "request": "launch",
      "type": "chrome",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend"
    }
  ]
}
